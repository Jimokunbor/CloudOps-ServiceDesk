        >
        <span class="brand-name">
          Cloud<span>Ops</span> ServiceDesk
        </span>
      </a>

      <div class="nav-links">
        <a href="#home">Home</a>
        <a href="#features">Capabilities</a>
        <a href="#gallery">Gallery</a>
