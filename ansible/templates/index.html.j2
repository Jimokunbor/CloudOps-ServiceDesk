  <main>

    <!-- Hero -->
    <section id="home" class="hero">
      <div class="container hero-grid">

        <div class="hero-content">

          <span class="eyebrow">
            CLOUD OPERATIONS & IT SERVICE MANAGEMENT
          </span>

          <h1>
            Smarter IT Operations.
            <span>Built for the Cloud.</span>
          </h1>

          <p>
            CloudOps ServiceDesk brings together secure
            IT service management, intelligent ticket
            analysis, backend engineering and cloud
            infrastructure automation.
          </p>

          <p>
            An evolving engineering platform demonstrating
            practical software development, cloud operations
            and DevOps implementation.
          </p>

          <p class="hero-slogan">
            People | Technology | Solutions
          </p>

          <div class="hero-actions">
            <a href="#features" class="btn btn-primary">
              Explore Capabilities
            </a>

            <a href="#gallery" class="btn btn-outline">
              Explore Our Technology
            </a>
          </div>

        </div>

        <div class="hero-visual">
          <img
            src="/images/cloudops-servicedesk-logo.png"
            alt="CloudOps ServiceDesk — People, Technology, Solutions"
          >
        </div>

      </div>
    </section>

    <!-- Capabilities -->
    <section id="features" class="section section-light">
      <div class="container">

        <div class="section-heading">
          <span class="section-label">Platform Capabilities</span>
          <h2>Engineering Better IT Service Operations</h2>
          <p>
            Explore the application features and engineering
            capabilities developed within CloudOps ServiceDesk.
          </p>
        </div>

        <div class="features-grid">

          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">01</div>
            <h3>Identity & Access Management</h3>
            <p>
              JWT authentication, password protection,
              authenticated endpoints and role-based
              access control for structured user access.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">02</div>
            <h3>IT Ticket Management</h3>
            <p>
              API-driven ticket creation, assignment,
              lifecycle management and technician-specific
              workflows for organized IT support.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">03</div>
            <h3>AI-Assisted Ticket Analysis</h3>
            <p>
              Implemented API capabilities for ticket
              classification, summarization and
              priority recommendations.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">04</div>
            <h3>Backend & Container Engineering</h3>
            <p>
              FastAPI, PostgreSQL, Docker, Nginx,
              Redis and Celery supporting application
              services and background processing.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">05</div>
            <h3>Cloud Infrastructure Automation</h3>
            <p>
              Terraform-managed AWS infrastructure and
              Ansible-based Linux configuration,
              Apache provisioning and website deployment.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">06</div>
            <h3>Cloud Security & FinOps</h3>
            <p>
              Documented AWS security configuration,
              HTTPS validation, cost budgets,
              database recovery snapshots and
              controlled infrastructure decommissioning.
            </p>
          </article>

        </div>
      </div>
    </section>

    <!-- Animated image gallery -->
    <section id="gallery" class="image-gallery"
             aria-labelledby="gallery-title">

      <div class="container">

        <div class="gallery-heading">
          <span class="section-label">Technology in Action</span>
          <h2 id="gallery-title">
            People, Infrastructure and Innovation
          </h2>
          <p>
            Visual representations of the people,
            engineering practices and technologies
            that inspire CloudOps ServiceDesk.
          </p>
        </div>

        <div class="gallery-frame"
             id="cloudops-gallery"
             aria-label="CloudOps technology image gallery">

          <div class="gallery-slide active">
            <img
              src="/images/cloudops-monitoring-dashboard.png"
              alt="IT operations monitoring environment"
            >
            <div class="gallery-caption">
              <h3>IT Infrastructure Monitoring</h3>
              <p>
                Operational visibility and infrastructure health.
              </p>
            </div>
          </div>

          <div class="gallery-slide">
            <img
              src="/images/cloudops-development-team.png"
              alt="Software engineering team collaborating"
              loading="lazy"
            >
            <div class="gallery-caption">
              <h3>Software Engineering Collaboration</h3>
              <p>
                Building reliable applications through teamwork.
              </p>
            </div>
          </div>

          <div class="gallery-slide">
            <img
              src="/images/cloudops-data-center.png"
              alt="Data centre and cloud infrastructure"
              loading="lazy"
            >
            <div class="gallery-caption">
              <h3>Cloud Infrastructure</h3>
              <p>
                Computing, networking and scalable infrastructure.
              </p>
            </div>
          </div>

          <div class="gallery-slide">
            <img
              src="/images/cloudops-analytics-dashboard.png"
              alt="System performance and analytics dashboards"
              loading="lazy"
            >
            <div class="gallery-caption">
              <h3>Performance & Analytics</h3>
              <p>
                Data-driven operational insights and reporting.
              </p>
            </div>
          </div>

          <div class="gallery-slide">
            <img
              src="/images/cloudops-technical-support-team.png"
              alt="IT service desk team providing technical support"
              loading="lazy"
            >
            <div class="gallery-caption">
              <h3>IT Service Desk Support</h3>
              <p>
                People-focused technical support and collaboration.
              </p>
            </div>
          </div>

        </div>

        <div class="gallery-indicators"
             aria-label="Gallery navigation">
          <button class="gallery-indicator active"
                  type="button"
                  aria-label="Show image 1"
                  aria-pressed="true"></button>
          <button class="gallery-indicator"
                  type="button"
                  aria-label="Show image 2"
                  aria-pressed="false"></button>
          <button class="gallery-indicator"
                  type="button"
                  aria-label="Show image 3"
                  aria-pressed="false"></button>
          <button class="gallery-indicator"
                  type="button"
                  aria-label="Show image 4"
                  aria-pressed="false"></button>
          <button class="gallery-indicator"
                  type="button"
                  aria-label="Show image 5"
                  aria-pressed="false"></button>
        </div>

        <p class="gallery-disclaimer">
          Illustrative photography representing IT and cloud
          engineering activities; not screenshots of the
          deployed CloudOps ServiceDesk application.
        </p>

      </div>
    </section>

    <!-- Platform overview -->
    <section id="platform" class="section">
      <div class="container overview-grid">

        <div class="overview-content">
          <span class="section-label">CloudOps Platform</span>

          <h2>
            From Application Development
            to Cloud Infrastructure
          </h2>

          <p>
            CloudOps ServiceDesk is an evolving IT service
            management and cloud engineering project
            combining secure application development,
            ticket workflows and infrastructure automation.
          </p>

          <p>
            Its documented development includes FastAPI,
            PostgreSQL, Docker, Redis, Celery, Terraform,
            AWS and Ansible.
          </p>

          <p>
            AWS resources were provisioned and tested
            during infrastructure milestones. Selected
            resources were subsequently decommissioned
            to control costs while preserving recovery
            assets and Terraform configuration.
          </p>

          <a href="#technology" class="btn btn-primary">
            View Technology Stack
          </a>
        </div>

        <div class="overview-panel">
          <h3>Development Overview</h3>

          <div class="status-list">

            <div class="status-item">
              <span>FastAPI & PostgreSQL</span>
              <span class="status-pill">Implemented</span>
            </div>

            <div class="status-item">
              <span>JWT Authentication & RBAC</span>
              <span class="status-pill">Implemented</span>
            </div>

            <div class="status-item">
              <span>Ticket Management & AI APIs</span>
              <span class="status-pill">Implemented</span>
            </div>

            <div class="status-item">
              <span>Docker & Background Processing</span>
              <span class="status-pill">Implemented</span>
            </div>

            <div class="status-item">
              <span>AWS & Terraform Milestones</span>
              <span class="status-pill">Verified</span>
            </div>

            <div class="status-item">
              <span>Ansible Website Deployment</span>
              <span class="status-pill">Implemented</span>
            </div>

          </div>

          <p>
            Status labels describe documented development
            milestones, not current production availability.
          </p>
        </div>

      </div>
    </section>

